# Honest Voice 環境設定
# .env ファイルにコピーして使用します

# ========================================
# Rails 設定
# ========================================

# 環境指定: development, test, production
RAILS_ENV=development

# ログ出力
RAILS_LOG_TO_STDOUT=true

# マスターキー（本番環境で必須、開発では不要）
# RAILS_MASTER_KEY=your-master-key-here

# SECRET_KEY_BASE（本番環境で必須）
SECRET_KEY_BASE=replace-with-secure-random-string

# ========================================
# Node.js / Frontend 設定
# ========================================

# Node 環境: development, production
NODE_ENV=development

# esbuild ウォッチモード（開発時）
ESBUILD_WATCH=true

# ========================================
# データベース設定
# ========================================

# SQLite（開発）
DATABASE_URL=sqlite3:db/development.sqlite3

# PostgreSQL（本番向け）
DATABASE_URL=postgresql://user:password@localhost:5432/honest_voice_prod

# ========================================
# API・サーバー設定
# ========================================

# Rails サーバーバインディングアドレス
RAILS_BIND_ADDR=0.0.0.0

# Rails サーバーポート
RAILS_PORT=3000

# Node.js フロントエンドサーバーポート
FRONTEND_PORT=5173

# ========================================
# セキュリティ設定（本番環境）
# ========================================

# CORS 設定
# CORS_ORIGINS=https://example.com,https://api.example.com

# ========================================
# 開発用オプション
# ========================================

# Rails コンソール自動起動（テスト用）
# RAILS_CONSOLE=true

# アセット圧縮を無効化（開発時高速化）
COMPRESS_ASSETS=false
